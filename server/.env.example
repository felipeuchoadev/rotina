# Copie para .env e preencha. NUNCA versione o .env real.

# Postgres (a VM roda o Postgres local; usuário/senha criados no deploy)
DATABASE_URL="postgresql://disciplina:TROQUE_ESTA_SENHA@localhost:5432/disciplina?schema=public"

# Segredo pra assinar os JWT — gere um aleatório forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="TROQUE_POR_UM_SEGREDO_ALEATORIO_LONGO"
JWT_EXPIRES="30d"

# Porta interna do backend (o Caddy/Nginx faz o proxy do 443 pra cá)
PORT=8090

# Origens permitidas (CORS). Em produção, o domínio do app.
# Ex: https://disciplina.duckdns.org  — separe por vírgula se tiver mais de um.
CORS_ORIGINS="http://localhost:8123,http://localhost:5500"

# Pasta onde as mídias enviadas ficam salvas em disco
UPLOAD_DIR="./uploads"

# URL pública base das mídias (o que o front usa pra exibir).
# Em produção normalmente é o próprio domínio + /uploads
PUBLIC_MEDIA_BASE="http://localhost:8090/uploads"
