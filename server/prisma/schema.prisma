// DISCIPLINA — modelo de dados (Postgres via Prisma)
// Modelo híbrido: dados PESSOAIS ficam como blobs chave-valor por usuário
// (UserState) — o app já é organizado atrás da camada Store, então isso liga o
// frontend ao backend sem reescrever as telas. Já FEED e RANKING são cross-user
// (tabelas próprias). Auth e perfil ficam em Usuario.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String   @id @default(uuid())
  email      String   @unique
  senhaHash  String
  username   String   @unique
  nomeGuerra String
  fotoUrl    String?  // dataURL ou URL de upload
  idade      Int?
  pesoKg     Float?
  alturaCm   Int?
  metaAgua   Int      @default(2500)
  tema       String   @default("red")
  xp         Int      @default(0) // auto-reportado pelo cliente, usado no ranking
  criadoEm   DateTime @default(now())

  states      UserState[]
  posts       FeedPost[]
  likes       FeedLike[]
  comentarios FeedComment[]

  @@map("usuarios")
}

// Blobs de dados pessoais do usuário (treino, estudo, alimentação, rotina, config…)
model UserState {
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  chave     String
  valor     Json

  @@id([usuarioId, chave])
  @@map("user_state")
}

model FeedPost {
  id          Int           @id @default(autoincrement())
  usuario     Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   String
  tipo        String        @default("manual")
  texto       String?
  midiaUrl    String?
  midiaTipo   String?
  criadoEm    DateTime      @default(now())
  likes       FeedLike[]
  comentarios FeedComment[]

  @@index([criadoEm])
  @@map("feed_posts")
}

model FeedLike {
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  @@id([postId, usuarioId])
  @@map("feed_likes")
}

model FeedComment {
  id        Int      @id @default(autoincrement())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  texto     String
  criadoEm  DateTime @default(now())

  @@map("feed_comments")
}
