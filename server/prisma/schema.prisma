// DISCIPLINA — modelo de dados (Postgres via Prisma)
// Modelo híbrido: dados PESSOAIS ficam como blobs chave-valor por usuário
// (UserState) — o app já é organizado atrás da camada Store, então isso liga o
// frontend ao backend sem reescrever as telas. Já FEED e RANKING são cross-user
// (tabelas próprias). Auth e perfil ficam em Usuario.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id         String   @id @default(uuid())
  email      String   @unique
  senhaHash  String
  username   String   @unique
  nomeGuerra String
  fotoUrl    String?  // dataURL ou URL de upload
  idade      Int?
  dataNasc   DateTime?
  genero     String?  // 'm' | 'f' — define avatar padrão
  resetToken String?  // reset de senha por e-mail (hash do token)
  resetExp   DateTime?
  secPergunta String? // pergunta de segurança (recuperação universal sem e-mail)
  secRespHash String? // hash da resposta
  pesoKg     Float?
  alturaCm   Int?
  metaAgua   Int      @default(2500)
  tema       String   @default("red")
  xp         Int      @default(0) // auto-reportado pelo cliente, usado no ranking
  privado    Boolean  @default(false)
  criadoEm   DateTime @default(now())
  ultimoAcesso DateTime?

  states      UserState[]
  posts       FeedPost[]
  likes       FeedLike[]
  comentarios FeedComment[]
  commentLikes FeedCommentLike[]
  seguindo    Follow[]      @relation("seguidor")
  seguidores  Follow[]      @relation("seguido")
  bloqueados  Block[]       @relation("bloqueador")
  bloqueadoPor Block[]      @relation("bloqueado")
  notificacoes Notificacao[] @relation("destinatario")
  msgEnviadas  Mensagem[]   @relation("de")
  msgRecebidas Mensagem[]   @relation("para")
  pushSubs     PushSub[]

  @@map("usuarios")
}

model PushSub {
  id        Int      @id @default(autoincrement())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now())

  @@map("push_subs")
}

model Mensagem {
  id       Int      @id @default(autoincrement())
  de       Usuario  @relation("de", fields: [deId], references: [id], onDelete: Cascade)
  deId     String
  para     Usuario  @relation("para", fields: [paraId], references: [id], onDelete: Cascade)
  paraId   String
  texto    String
  midiaUrl String?
  midiaTipo String?
  entregue Boolean  @default(false)
  lida     Boolean  @default(false)
  apagadaDe Boolean @default(false)
  apagadaPara Boolean @default(false)
  apagadaTodos Boolean @default(false)
  respostaAId Int?
  respostaTexto String?
  respostaTipo String?
  respostaMeu Boolean?
  criadoEm DateTime @default(now())

  @@index([deId, paraId])
  @@index([paraId, lida])
  @@map("mensagens")
}

model Follow {
  seguidor    Usuario  @relation("seguidor", fields: [seguidorId], references: [id], onDelete: Cascade)
  seguidorId  String
  seguido     Usuario  @relation("seguido", fields: [seguidoId], references: [id], onDelete: Cascade)
  seguidoId   String
  criadoEm    DateTime @default(now())

  @@id([seguidorId, seguidoId])
  @@map("follows")
}

model Block {
  bloqueador   Usuario  @relation("bloqueador", fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String
  bloqueado    Usuario  @relation("bloqueado", fields: [bloqueadoId], references: [id], onDelete: Cascade)
  bloqueadoId  String
  criadoEm     DateTime @default(now())

  @@id([usuarioId, bloqueadoId])
  @@map("blocks")
}

model Notificacao {
  id           Int      @id @default(autoincrement())
  destinatario Usuario  @relation("destinatario", fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String
  tipo         String   // 'seguidor' | 'curtida' | 'comentario' | 'aviso'
  texto        String
  deUsername   String?
  alvoPostId   Int?     // deep-link: post que originou a notificação (curtida/comentário)
  alvoCommentId Int?
  lida         Boolean  @default(false)
  criadoEm     DateTime @default(now())

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

// Estado interno do servidor (chave→valor). Ex.: última execução da agenda de avisos.
model Kv {
  chave String @id
  valor Json
  @@map("kv")
}

// Blobs de dados pessoais do usuário (treino, estudo, alimentação, rotina, config…)
model UserState {
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  chave     String
  valor     Json
  versao    BigInt  @default(0)

  @@id([usuarioId, chave])
  @@map("user_state")
}

model StateHistory {
  id        BigInt   @id @default(autoincrement())
  usuarioId String
  chave     String
  valor     Json
  criadoEm  DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@index([usuarioId, chave, criadoEm])
  @@map("state_history")
}

model FeedPost {
  id          Int           @id @default(autoincrement())
  usuario     Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   String
  tipo        String        @default("manual")
  texto       String?
  midiaUrl    String?
  midiaTipo   String?
  midias      Json?
  comentariosOff Boolean    @default(false)
  privado     Boolean       @default(false)
  criadoEm    DateTime      @default(now())
  likes       FeedLike[]
  comentarios FeedComment[]

  @@index([criadoEm])
  @@map("feed_posts")
}

model StoryView {
  ownerId  String
  recordId String
  viewerId String
  vistoEm  DateTime @default(now())

  @@id([ownerId, recordId, viewerId])
  @@index([ownerId, recordId, vistoEm])
  @@map("story_views")
}

model FeedLike {
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String

  @@id([postId, usuarioId])
  @@map("feed_likes")
}

model FeedComment {
  id        Int      @id @default(autoincrement())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  texto     String
  parentId  Int?
  parent    FeedComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   FeedComment[] @relation("CommentReplies")
  likes     FeedCommentLike[]
  criadoEm  DateTime @default(now())

  @@index([postId, parentId])
  @@map("feed_comments")
}

model FeedCommentLike {
  comment   FeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  criadoEm  DateTime @default(now())

  @@id([commentId, usuarioId])
  @@map("feed_comment_likes")
}
